BOT_TOKEN=your_discord_bot_token_here

# ── Listener stats (optional) ───────────────────────────────────────────────
# Leave DB_HOST blank to run without stats — the bot works exactly as before,
# and /listentime, /toplisteners, /optout and /forgetme report as unavailable.

# Using the bundled MariaDB from docker-compose? Uncomment the line below and
# leave DB_HOST as mariadb. Using your own database server instead? Leave this
# commented out so the extra container is never started, and point DB_HOST at it.
#COMPOSE_PROFILES=local-db

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ephemeral_bot
DB_USER=ephemeral_bot
DB_PASSWORD=change_me

# Only used by the bundled MariaDB container. Ignored with an external database.
DB_ROOT_PASSWORD=change_me_too

# ── TLS to an external database ─────────────────────────────────────────────
# Not needed for the bundled container — that traffic never leaves the private
# Docker network. Set DB_SSL=true when the database is on another host.
#DB_SSL=true

# A self-hosted MariaDB usually presents a self-signed certificate, which fails
# default verification. Point this at its CA file to verify it properly.
#DB_SSL_CA=/app/certs/ca.pem

# Last resort. Still encrypts, but stops checking who is on the other end, so it
# cannot detect an intercepted connection. Prefer DB_SSL_CA above.
#DB_SSL_REJECT_UNAUTHORIZED=false
